{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|MultiEdit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/css-guard.js\"",
            "timeout": 15
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "asogepes-qa@asogepes-mods": true,
    "asogepes-elotte-utana@asogepes-mods": true
  }
}
